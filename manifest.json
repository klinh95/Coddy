{
  "manifest_version": 3,
  "name": "Coddy Helper",
  "version": "1.3.0",
  "description": "Khắc phục định tuyến API và hỗ trợ Gemini ổn định hơn.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://coddy.tech/*",
    "https://*.coddy.tech/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Coddy Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coddy.tech/*",
        "https://*.coddy.tech/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://coddy.tech/*",
        "https://*.coddy.tech/*"
      ]
    }
  ]
}
